   DEBUG: 2026-02-23 23:42:24,578:      pdf_renderer.py:  470: printSegment: | 60 | 12 | 49,250 | 0.9693 | 0.9729 | 
   DEBUG: 2026-02-23 23:42:24,578:      pdf_renderer.py:  470: printSegment: 0.9741
   DEBUG: 2026-02-23 23:42:24,578:      pdf_renderer.py:  470: printSegment:  |
